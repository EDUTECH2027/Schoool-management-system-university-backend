generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_TEMPLATE_DATABASE_URL")
}

enum Role {
  super_admin
  head_teacher
  teacher
  student
  parent
  finance_officer
  academic_officer
}

enum Gender {
  male
  female
  other
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TermName {
  first
  second
  third
}

enum Day {
  monday
  tuesday
  wednesday
  thursday
  friday
}

enum TranscriptStatus {
  draft
  finalized
  published
  printed
}

enum FeeStatus {
  pending
  partial
  paid
  overdue
  waived
}

enum PayrollStatus {
  draft
  pending
  paid
}

enum BehaviorCategory {
  positive
  negative
  neutral
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

enum ForumMessageType {
  text
  image
  voice
  video
}

enum CertificateKind {
  certificate
  attestation
}

// ── Users (auth) ──────────────────────────────────────────────────
model User {
  id                   String    @id
  name                 String
  email                String    @unique
  password_hash        String
  role                 Role
  initials             String
  teacher_id           String?
  student_id           String?
  parent_id            String?
  must_change_password Boolean   @default(false)
  created_at           DateTime? @default(now())
  updated_at           DateTime? @default(now())

  teacher Teacher? @relation("UserTeacherRef", fields: [teacher_id], references: [id], onDelete: SetNull)
  student Student? @relation("UserStudentRef", fields: [student_id], references: [id], onDelete: SetNull)
  parent  Parent?  @relation("UserParentRef", fields: [parent_id], references: [id], onDelete: SetNull)

  teachers_linked         Teacher[]          @relation("TeacherUserRef")
  students_linked         Student[]          @relation("StudentUserRef")
  parents_linked          Parent[]           @relation("ParentUserRef")
  announcements_authored  Announcement[]     @relation("AnnouncementAuthor")
  email_alerts_sent       EmailAlert[]       @relation("EmailAlertSender")
  forum_threads_authored  ForumThread[]      @relation("ForumThreadAuthor")
  forum_messages_authored ForumMessage[]     @relation("ForumMessageAuthor")
  behavior_logs_created   StudentBehavior[]  @relation("BehaviorCreatedBy")
  withdrawals_reviewed    SalaryWithdrawal[] @relation("WithdrawalReviewedBy")

  @@map("users")
}

enum PasswordResetStatus {
  pending
  approved
  resolved
  dismissed
}

// A forgotten-password request raised from the login screen. Approving it
// (admin action) doesn't set a new password itself — it just authorizes the
// self-service reset-password endpoint to accept one new-password submission
// for this email, with no old/temp password required.
model PasswordResetRequest {
  id           String              @id
  email        String
  status       PasswordResetStatus @default(pending)
  requested_at DateTime?           @default(now())
  approved_at  DateTime?
  approved_by  String?

  @@index([email])
  @@index([status])
  @@map("password_reset_requests")
}

// ── School (singleton profile row) ───────────────────────────────
model School {
  id           String    @id
  name         String
  code         String?
  address      String?
  phone        String?
  email        String?
  head_teacher String?
  motto        String?
  logo_url     String?
  updated_at   DateTime? @default(now())

  // Matricule (student ID) nomenclature — configurable per school in Settings.
  // A generated matricule is [prefix][sep][year if included][sep][seq padded to digits],
  // e.g. prefix="BSPS", digits=3 → "BSPS-2026-001". Defaults reproduce the format
  // that was previously hardcoded in routes/students.js, so existing schools see no change.
  matricule_prefix       String  @default("BSPS")
  matricule_include_year Boolean @default(true)
  matricule_digits       Int     @default(3)
  matricule_separator    String  @default("-")

  @@map("school")
}

model AcademicYear {
  id         String  @id
  label      String
  start_date String
  end_date   String
  is_current Boolean @default(false)

  terms Term[]

  @@map("academic_years")
}

model Term {
  id               String   @id
  academic_year_id String
  name             TermName
  start_date       String
  end_date         String
  is_current       Boolean  @default(false)

  academic_year      AcademicYear      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  marks              Mark[]
  transcript_entries TranscriptEntry[]
  offerings          CourseOffering[]
  registration_periods RegistrationPeriod[]
  exams              ExamSession[]

  @@map("terms")
}

model GradeLevel {
  id         String @id
  name       String @unique
  sort_order Int    @default(0)

  classes Class[]
  subjects Subject[]

  @@map("grade_levels")
}

model Subject {
  id           String @id
  name         String @unique
  code         String @unique
  coefficient  Float  @default(1)
  credit_hours Float  @default(3)
  // Course-catalogue fields (a Subject IS the catalogue entry; credit_hours = credit units)
  department_id String?
  level_id      String?
  semester      TermName?
  description   String?
  is_active     Boolean @default(true)

  department    Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  level         GradeLevel?          @relation(fields: [level_id], references: [id], onDelete: SetNull)
  prerequisites CoursePrerequisite[] @relation("CourseOf")
  required_by   CoursePrerequisite[] @relation("PrereqOf")
  curriculum    ProgrammeCourse[]
  offerings     CourseOffering[]
  exams         ExamSession[]

  marks              Mark[]
  transcript_entries TranscriptEntry[]

  @@index([department_id])

  @@map("subjects")
}

model Teacher {
  id             String    @id
  first_name     String
  last_name      String
  email          String    @unique
  phone          String?
  gender         Gender?
  subjects       Json      @default("[]")
  class_assigned String?
  qualification  String?
  join_date      String?
  is_active      Boolean   @default(true)
  user_id        String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())

  user              User?               @relation("TeacherUserRef", fields: [user_id], references: [id], onDelete: SetNull)
  users_referencing User[]              @relation("UserTeacherRef")
  classes_led       Class[]             @relation("ClassTeacher")
  schedule          TeacherSchedule[]
  attendance        TeacherAttendance[]
  payroll           TeacherPayroll[]
  behavior_logs     StudentBehavior[]   @relation("BehaviorTeacher")
  withdrawals       SalaryWithdrawal[]
  documents         TeacherDocument[]
  elearning_sessions ElearningSession[]
  elearning_resources ElearningResource[]
  offerings          CourseOffering[]
  invigilations      ExamInvigilator[]

  @@map("teachers")
}

model TeacherDocument {
  id         String    @id
  teacher_id String
  title      String
  file_url   String
  created_at DateTime? @default(now())

  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([teacher_id])
  @@map("teacher_documents")
}

model Class {
  id                 String    @id
  grade_level_id     String?
  grade_level_name   String?
  name               String    @unique
  capacity           Int       @default(40)
  room               String?
  class_teacher_id   String?
  class_teacher_name String?
  enrolled           Int       @default(0)
  programme_id       String?
  created_at         DateTime? @default(now())

  programme          Programme?         @relation(fields: [programme_id], references: [id], onDelete: SetNull)
  grade_level        GradeLevel?        @relation(fields: [grade_level_id], references: [id])
  class_teacher      Teacher?           @relation("ClassTeacher", fields: [class_teacher_id], references: [id], onDelete: SetNull)
  students           Student[]
  attendance_records AttendanceRecord[]
  schedule           TeacherSchedule[]
  marks              Mark[]
  fee_records        FeeRecord[]
  behavior_logs      StudentBehavior[]
  elearning_sessions ElearningSession[]
  elearning_resources ElearningResource[]

  @@index([programme_id])
  @@map("classes")
}

model Student {
  id                      String    @id
  student_number          String    @unique
  first_name              String
  middle_name             String?
  last_name               String
  date_of_birth           String?
  gender                  Gender?
  class_id                String?
  class_name              String?
  grade_level_name        String?
  photo_url               String?
  address                 String?
  city                    String?
  state                   String?
  zip_code                String?
  mobile_number           String?
  alternate_mobile_number String?
  sibling_ids             Json      @default("[]")
  guardian_name           String?
  guardian_phone          String?
  guardian_relationship   String?
  admission_date          String?
  is_active               Boolean   @default(true)
  academic_status         String    @default("active")   // active | graduated | withdrawn | suspended
  user_id                 String?
  created_at              DateTime? @default(now())
  updated_at              DateTime? @default(now())

  class              Class?             @relation(fields: [class_id], references: [id], onDelete: SetNull)
  user               User?              @relation("StudentUserRef", fields: [user_id], references: [id], onDelete: SetNull)
  users_referencing  User[]             @relation("UserStudentRef")
  parents            ParentStudent[]
  attendance_records AttendanceRecord[]
  marks              Mark[]
  transcript         Transcript?
  fee_records        FeeRecord[]
  behavior_logs      StudentBehavior[]
  certificates       Certificate[]
  documents          StudentDocument[]

  @@index([class_id])
  @@index([is_active])
  payment_transactions PaymentTransaction[]
  enrollments          CourseEnrollment[]
  exam_entries         ExamCandidate[]
  grade_appeals        GradeAppeal[]
  enrollment_history   StudentEnrollmentHistory[]
  progression          ProgressionDecision[]
  official_documents   OfficialDocument[]
  @@map("students")
}

model StudentDocument {
  id         String    @id
  student_id String
  title      String
  file_url   String
  created_at DateTime? @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@map("student_documents")
}

model Parent {
  id           String    @id
  name         String
  email        String?
  phone        String
  relationship String?
  address      String?
  occupation   String?
  user_id      String?
  created_at   DateTime? @default(now())
  updated_at   DateTime? @default(now())

  user              User?           @relation("ParentUserRef", fields: [user_id], references: [id], onDelete: SetNull)
  users_referencing User[]          @relation("UserParentRef")
  children          ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  parent_id  String
  student_id String

  parent  Parent  @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@id([parent_id, student_id])
  @@map("parent_students")
}

model AttendanceRecord {
  id             String           @id
  student_id     String
  student_name   String?
  student_number String?
  class_id       String
  class_name     String?
  date           String
  status         AttendanceStatus
  remarks        String?
  created_at     DateTime?        @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([student_id, date], name: "attendance_student_date")
  @@index([date])
  @@index([class_id])
  @@map("attendance_records")
}

model TeacherAttendance {
  id         String           @id
  teacher_id String
  date       String
  status     AttendanceStatus
  remarks    String?

  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, date], name: "teacher_attendance_teacher_date")
  @@map("teacher_attendance")
}

model TeacherSchedule {
  id           String  @id
  teacher_id   String
  day          Day
  period_key   String
  period_label String?
  time         String?
  class_id     String
  class_name   String?
  subject_name String
  room         String?

  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@index([teacher_id])
  @@map("teacher_schedule")
}

model Mark {
  id             String    @id
  student_id     String
  student_name   String?
  student_number String?
  subject_id     String
  subject_name   String?
  term_id        String
  class_id       String?
  ca_score       Float     @default(0)
  exam_score     Float     @default(0)
  total_score    Float     @default(0)
  grade          String?
  remark         String?
  resit_score    Float?
  resit_grade    String?
  // Results workflow: draft → submitted (by lecturer) → approved → published (visible to students)
  status         MarkStatus @default(draft)
  exam_absent    Boolean   @default(false)
  offering_id    String?
  entered_by     String?
  submitted_at   DateTime?
  submitted_by   String?
  approved_at    DateTime?
  approved_by    String?
  published_at   DateTime?
  published_by   String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())

  history MarkHistory[]
  appeals GradeAppeal[]
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [term_id], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [class_id], references: [id], onDelete: SetNull)

  @@unique([student_id, subject_id, term_id], name: "marks_student_subject_term")
  @@index([student_id])
  @@index([term_id])
  @@index([status])
  @@index([subject_id, term_id])
  @@map("marks")
}

// A school-wide window during which teachers may submit marks (their own
// /api/portal/teacher/marks route only — admins entering marks directly via
// the Assessments page are never gated by this). "Open" means now falls
// between start_at and end_at; closing early just moves end_at up to now,
// so there's no separate closed flag to keep in sync.
model MarksSession {
  id         String    @id
  label      String?
  start_at   DateTime
  end_at     DateTime
  created_by String?
  created_at DateTime? @default(now())

  @@index([start_at, end_at])
  @@map("marks_sessions")
}

// Cumulative, whole-career academic record — one row per student (see
// @@unique below). Regenerated in place by POST /api/transcripts/generate,
// which snapshots credit_hours/grade_points onto each entry at that moment
// (see TranscriptEntry) so a later edit to a subject's credit hours doesn't
// retroactively change an already-generated transcript until it's regenerated.
model Transcript {
  id                   String           @id
  student_id           String           @unique
  student_name         String?
  student_number       String?
  class_name           String?
  grade_level_name     String?
  cumulative_gpa       Float            @default(0)
  total_credit_hours   Float            @default(0)
  total_quality_points Float            @default(0)
  terms_included       Int              @default(0)
  status               TranscriptStatus @default(draft)
  generated_at         DateTime?
  created_at           DateTime?        @default(now())
  updated_at           DateTime?        @default(now())

  student Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  entries TranscriptEntry[]

  @@map("transcripts")
}

model TranscriptEntry {
  id            String  @id
  transcript_id String
  term_id       String
  term_name     String?
  academic_year String?
  subject_id    String
  subject_name  String?
  ca_score      Float   @default(0)
  exam_score    Float   @default(0)
  total_score   Float   @default(0)
  credit_hours  Float   @default(3)
  grade         String?
  grade_points  Float   @default(0)
  remark        String?

  transcript Transcript @relation(fields: [transcript_id], references: [id], onDelete: Cascade)
  term       Term       @relation(fields: [term_id], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([transcript_id, subject_id, term_id], name: "transcript_entry_unique")
  @@index([transcript_id])
  @@map("transcript_entries")
}

model FeeRecord {
  id             String    @id
  student_id     String
  student_name   String?
  student_number String?
  class_id       String?
  class_name     String?
  fee_name       String
  academic_year  String?
  amount_due     Float     @default(0)
  amount_paid    Float     @default(0)
  balance        Float     @default(0)
  status         FeeStatus @default(pending)
  due_date       String?
  currency       String    @default("XAF")
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())

  transactions PaymentTransaction[]
  student  Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class    Class?    @relation(fields: [class_id], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([student_id])
  @@index([status])
  @@index([class_id])
  @@index([academic_year])
  @@map("fee_records")
}

model Payment {
  id             String    @id
  fee_record_id  String
  amount         Float
  method         String?
  reference      String?
  payment_date   String?
  receipt_number String?
  created_at     DateTime? @default(now())

  // Online / bank payments link back to the verified transaction that produced them (unique ⇒ a
  // transaction can never produce two receipts). kind 'refund' rows carry a negative amount.
  transaction_id    String?  @unique
  kind              String   @default("payment")
  recorded_by       String?
  reverses_payment_id String?

  fee_record FeeRecord @relation(fields: [fee_record_id], references: [id], onDelete: Cascade)
  transaction PaymentTransaction?

  @@index([fee_record_id])
  @@map("payments")
}

model TeacherPayroll {
  id                String        @id
  teacher_id        String
  month             String
  hourly_rate       Float         @default(3500)
  contracted_hours  Float         @default(80)
  base_allowance    Float         @default(50000)
  absence_deduction Float         @default(12000)
  late_deduction    Float         @default(2500)
  hours_worked      Float         @default(0)
  absences          Int           @default(0)
  late_coming       Int           @default(0)
  bonus             Float         @default(0)
  notes             String?       @default("")
  status            PayrollStatus @default(draft)
  created_at        DateTime?     @default(now())
  updated_at        DateTime?     @default(now())

  teacher     Teacher            @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  withdrawals SalaryWithdrawal[]

  @@unique([teacher_id, month], name: "teacher_payroll_teacher_month")
  @@index([month])
  @@map("teacher_payroll")
}

model Announcement {
  id         String    @id
  title      String
  body       String
  author     String?
  author_id  String?
  audience   String?   @default("all")
  is_pinned  Boolean   @default(false)
  type       String?   @default("info")
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())

  author_user User? @relation("AnnouncementAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  @@map("announcements")
}

model EmailAlert {
  id        String    @id
  subject   String
  body      String
  recipient String
  sender    String?
  sender_id String?
  status    String    @default("sent")
  sent_at   DateTime? @default(now())

  sender_user User? @relation("EmailAlertSender", fields: [sender_id], references: [id], onDelete: SetNull)

  @@map("email_alerts")
}

model ForumThread {
  id            String    @id
  title         String
  tag           String?   @default("general")
  author        String?
  author_id     String?
  is_pinned     Boolean   @default(false)
  message_count Int       @default(0)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())

  author_user User?          @relation("ForumThreadAuthor", fields: [author_id], references: [id], onDelete: SetNull)
  messages    ForumMessage[]

  @@map("forum_threads")
}

model ForumMessage {
  id             String           @id
  thread_id      String
  author         String
  author_id      String?
  type           ForumMessageType @default(text)
  content        String?
  image_url      String?
  voice_url      String?
  voice_duration Int?
  video_url      String?
  video_duration Int?
  created_at     DateTime?        @default(now())

  thread      ForumThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  author_user User?       @relation("ForumMessageAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  @@index([thread_id, created_at])
  @@map("forum_messages")
}

model StudentBehavior {
  id           String           @id
  student_id   String
  class_id     String?
  teacher_id   String?
  date         String
  category     BehaviorCategory
  description  String
  action_taken String?
  created_by   String?
  created_at   DateTime?        @default(now())
  updated_at   DateTime?        @default(now())

  student      Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class        Class?   @relation(fields: [class_id], references: [id], onDelete: SetNull)
  teacher      Teacher? @relation("BehaviorTeacher", fields: [teacher_id], references: [id], onDelete: SetNull)
  created_user User?    @relation("BehaviorCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([student_id])
  @@index([class_id])
  @@map("student_behavior")
}

model SalaryWithdrawal {
  id          String           @id
  teacher_id  String
  payroll_id  String?
  amount      Float
  reason      String?
  status      WithdrawalStatus @default(pending)
  reviewed_by String?
  reviewed_at String?
  notes       String?
  created_at  DateTime?        @default(now())
  updated_at  DateTime?        @default(now())

  teacher  Teacher         @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  payroll  TeacherPayroll? @relation(fields: [payroll_id], references: [id], onDelete: SetNull)
  reviewer User?           @relation("WithdrawalReviewedBy", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([teacher_id])
  @@map("salary_withdrawals")
}

model Certificate {
  id              String          @id
  student_id      String
  student_name    String?
  student_number  String?
  class_name      String?
  doc_type_id     String
  theme_id        String
  kind            CertificateKind @default(certificate)
  doc_label       String
  body_html       String          @default("")
  recipient_name  String
  issue_date      String
  cert_number     String
  signatory_name  String?
  signatory_title String?
  style           Json?
  created_by      String?
  created_at      DateTime?       @default(now())
  updated_at      DateTime?       @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@map("certificates")
}

// ── E-learning (live classes) ─────────────────────────────────────
enum ElearningStatus {
  scheduled
  live
  ended
  cancelled
}

// A "course" is Class + subject_name + Teacher (matches TeacherSchedule), so a
// student is enrolled in every session of their own Class.
model ElearningSession {
  id           String          @id
  class_id     String
  subject_name String
  teacher_id   String
  title        String
  description  String?
  starts_at    DateTime
  ends_at      DateTime
  status       ElearningStatus @default(scheduled)
  room_name    String          @unique
  started_at   DateTime?
  ended_at     DateTime?
  reminder_sent_at DateTime?
  created_at   DateTime?       @default(now())
  updated_at   DateTime?       @default(now())

  class      Class                        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher    Teacher                      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  attendance ElearningSessionAttendance[]
  resources  ElearningResource[]

  @@index([class_id, starts_at])
  @@index([teacher_id, starts_at])
  @@map("elearning_sessions")
}

model ElearningSessionAttendance {
  id               String    @id
  session_id       String
  user_id          String
  user_name        String
  role             String
  student_id       String?
  teacher_id       String?
  joined_at        DateTime  @default(now())
  last_seen_at     DateTime  @default(now())
  left_at          DateTime?
  duration_seconds Int       @default(0)

  session ElearningSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([session_id, user_id])
  @@map("elearning_session_attendance")
}

// Learning material for a course (Class + subject). File bytes live in file_data and are
// served only through an authorised endpoint.
model ElearningResource {
  id            String    @id
  class_id      String
  subject_name  String
  teacher_id    String
  session_id    String?
  topic         String?
  kind          String    // 'file' | 'link'
  title         String
  url           String?   // external link (kind = link)
  file_key      String?   // legacy (files used to live on disk); unused
  file_data     Bytes?    // file contents (kind = file) — kept in the DB, Render's disk is ephemeral
  original_name String?
  mime_type     String?
  size_bytes    Int?
  created_at    DateTime? @default(now())

  class   Class             @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher Teacher           @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  session ElearningSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@index([class_id, subject_name])
  @@index([session_id])
  @@map("elearning_resources")
}

// In-app notifications (class scheduled / rescheduled / cancelled / live / reminder).
model Notification {
  id         String    @id
  user_id    String
  type       String
  title      String
  body       String?
  link       String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, read_at])
  @@index([user_id, created_at])
  @@map("notifications")
}

// ── Payments ──────────────────────────────────────────────────────────────────
// A PaymentTransaction is one attempt to pay (part of) an invoice (FeeRecord). It only affects the
// invoice's balance once a VERIFIED provider result (or a finance officer, for bank transfers) marks it
// 'successful' — at which point exactly one Payment (receipt) row is created. See src/payments/service.js.
enum PaymentTxStatus {
  initiated
  pending
  processing
  successful
  failed
  cancelled
  awaiting_verification
  refunded
  expired
}

model PaymentTransaction {
  id               String          @id
  reference        String          @unique   // shown to the student; used as the bank-transfer reference / provider order id
  fee_record_id    String
  student_id       String
  amount           Float
  currency         String
  provider         String                    // orange_money | mtn_momo | bank_transfer | stripe
  status           PaymentTxStatus @default(initiated)
  provider_ref     String?                   // provider-side id (MTN referenceId, Orange pay_token, Stripe session id)
  provider_txn_id  String?                   // provider's final financial transaction id
  provider_secret  String?                   // per-transaction verification token (e.g. Orange notif_token); never sent to the client
  payer_phone      String?
  checkout_url     String?
  idempotency_key  String?
  failure_reason   String?
  bank_reference   String?                   // reference written on the student's bank slip
  receipt_name     String?
  receipt_mime     String?
  receipt_size     Int?
  receipt_data     Bytes?                    // uploaded bank-transfer proof (pending until a finance officer verifies it)
  initiated_by     String?
  verified_by      String?
  verified_at      DateTime?
  expires_at       DateTime?
  needs_review     Boolean         @default(false)
  review_note      String?
  refunded_amount  Float           @default(0)
  payment_id       String?         @unique
  created_at       DateTime        @default(now())
  updated_at       DateTime        @default(now())

  fee_record FeeRecord @relation(fields: [fee_record_id], references: [id], onDelete: Restrict)
  student    Student   @relation(fields: [student_id], references: [id], onDelete: Restrict)
  payment    Payment?  @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  events     PaymentEvent[]

  @@unique([student_id, idempotency_key])
  @@index([fee_record_id])
  @@index([student_id, created_at])
  @@index([status, created_at])
  @@index([provider, status])
  @@map("payment_transactions")
}

// Status history of a transaction (what changed, who/what changed it, and the provider payload that justified it).
model PaymentEvent {
  id             String    @id
  transaction_id String
  from_status    String?
  to_status      String
  source         String                      // student | provider_webhook | provider_poll | finance_officer | admin | system
  actor_id       String?
  actor_name     String?
  note           String?
  payload        Json?
  created_at     DateTime  @default(now())

  transaction PaymentTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id, created_at])
  @@map("payment_events")
}

// Every provider notification we have received — unique (provider, event_id) makes re-delivery harmless.
model PaymentWebhookEvent {
  id           String    @id
  provider     String
  event_id     String
  payload      Json?
  outcome      String?
  received_at  DateTime  @default(now())
  processed_at DateTime?

  @@unique([provider, event_id])
  @@map("payment_webhook_events")
}

// Audit trail for sensitive finance actions: who, when, what changed and why.
model FinanceAudit {
  id          String   @id
  actor_id    String?
  actor_name  String?
  actor_role  String?
  action      String
  target_type String
  target_id   String
  reason      String?
  before      Json?
  after       Json?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([target_type, target_id])
  @@map("finance_audit")
}

// ══ Academic structure ═══════════════════════════════════════════════════════
model Faculty {
  id          String   @id
  name        String   @unique
  code        String   @unique
  description String?
  created_at  DateTime @default(now())

  departments Department[]

  @@map("faculties")
}

model Department {
  id         String   @id
  faculty_id String
  name       String
  code       String
  head_name  String?
  created_at DateTime @default(now())

  faculty    Faculty     @relation(fields: [faculty_id], references: [id], onDelete: Restrict)
  programmes Programme[]
  subjects   Subject[]

  @@unique([faculty_id, code])
  @@unique([faculty_id, name])
  @@map("departments")
}

// A Programme is what a student studies; Classes are its cohorts (per level / intake).
model Programme {
  id               String   @id
  department_id    String
  name             String
  code             String   @unique
  award            String?                // Licence, Master, Doctorat, BTS…
  duration_years   Int      @default(3)
  credits_required Float?                 // credits needed to graduate
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  department Department           @relation(fields: [department_id], references: [id], onDelete: Restrict)
  classes    Class[]
  curriculum ProgrammeCourse[]
  periods    RegistrationPeriod[]

  @@index([department_id])
  @@map("programmes")
}

model CoursePrerequisite {
  subject_id      String
  prerequisite_id String

  subject      Subject @relation("CourseOf", fields: [subject_id], references: [id], onDelete: Cascade)
  prerequisite Subject @relation("PrereqOf", fields: [prerequisite_id], references: [id], onDelete: Cascade)

  @@id([subject_id, prerequisite_id])
  @@map("course_prerequisites")
}

// Which courses belong to a programme, at which level and semester.
model ProgrammeCourse {
  id           String   @id
  programme_id String
  subject_id   String
  level_id     String?
  semester     TermName
  kind         String   @default("core")   // core | elective

  programme Programme @relation(fields: [programme_id], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([programme_id, subject_id])
  @@index([subject_id])
  @@map("programme_courses")
}

// A course taught in a given semester (term) by a lecturer: the unit students register for.
model CourseOffering {
  id         String   @id
  subject_id String
  term_id    String
  teacher_id String?
  section    String   @default("A")
  capacity   Int?
  is_open    Boolean  @default(true)
  created_at DateTime @default(now())

  subject     Subject            @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  term        Term               @relation(fields: [term_id], references: [id], onDelete: Cascade)
  teacher     Teacher?           @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  slots       OfferingSlot[]
  enrollments CourseEnrollment[]
  exams       ExamSession[]

  @@unique([subject_id, term_id, section])
  @@index([term_id])
  @@index([teacher_id])
  @@map("course_offerings")
}

// Weekly meeting slot of an offering — used for timetable-conflict detection at registration.
model OfferingSlot {
  id          String @id
  offering_id String
  day         Day
  period_key  String
  room        String?

  offering CourseOffering @relation(fields: [offering_id], references: [id], onDelete: Cascade)

  @@unique([offering_id, day, period_key])
  @@map("offering_slots")
}

model RegistrationPeriod {
  id               String    @id
  term_id          String
  programme_id     String?                 // null = every programme
  level_id         String?                 // null = every level
  name             String?
  opens_at         DateTime
  closes_at        DateTime
  add_drop_until   DateTime?               // adding/dropping allowed until (defaults to closes_at)
  min_credits      Float     @default(0)
  max_credits      Float     @default(30)
  allow_exceptions Boolean   @default(true)
  created_by       String?
  created_at       DateTime  @default(now())

  term      Term       @relation(fields: [term_id], references: [id], onDelete: Cascade)
  programme Programme? @relation(fields: [programme_id], references: [id], onDelete: Cascade)

  @@index([term_id, opens_at])
  @@map("registration_periods")
}

enum EnrollmentStatus {
  registered
  pending_approval
  rejected
  dropped
}

model CourseEnrollment {
  id               String           @id
  student_id       String
  offering_id      String
  term_id          String
  status           EnrollmentStatus @default(registered)
  credits          Float
  kind             String           @default("regular")   // regular | retake | exception
  exception_reason String?
  registered_at    DateTime         @default(now())
  dropped_at       DateTime?
  decision_by      String?
  decision_at      DateTime?
  decision_note    String?
  created_by       String?

  student  Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offering_id], references: [id], onDelete: Cascade)

  @@unique([student_id, offering_id])
  @@index([student_id, term_id])
  @@index([offering_id, status])
  @@map("course_enrollments")
}

// ══ Grading, results workflow, exams ════════════════════════════════════════════
enum MarkStatus {
  draft
  submitted
  approved
  published
}

model GradingScheme {
  id          String   @id
  name        String
  is_active   Boolean  @default(false)
  ca_weight   Float    @default(40)     // percent of the total coming from continuous assessment
  exam_weight Float    @default(60)
  pass_mark   Float    @default(50)     // course pass mark (out of 100)
  resit_cap   Float?                    // max total after a resit (null = no cap)
  created_at  DateTime @default(now())

  bands GradeBand[]

  @@map("grading_schemes")
}

model GradeBand {
  id        String  @id
  scheme_id String
  min_score Float
  grade     String
  points    Float
  remark    String?
  is_pass   Boolean @default(true)

  scheme GradingScheme @relation(fields: [scheme_id], references: [id], onDelete: Cascade)

  @@unique([scheme_id, grade])
  @@map("grade_bands")
}

// Every change to a mark and every approval step — nothing is ever silently overwritten.
model MarkHistory {
  id          String   @id
  mark_id     String
  action      String                      // save | submit | approve | publish | reject | reopen | appeal_upheld
  from_status String?
  to_status   String?
  before      Json?
  after       Json?
  reason      String?
  actor_id    String?
  actor_name  String?
  actor_role  String?
  created_at  DateTime @default(now())

  mark Mark @relation(fields: [mark_id], references: [id], onDelete: Cascade)

  @@index([mark_id, created_at])
  @@map("mark_history")
}

model ExamSession {
  id          String   @id
  subject_id  String
  term_id     String
  offering_id String?
  title       String
  kind        String   @default("final")      // final | midterm | resit
  date        String                           // YYYY-MM-DD
  start_time  String                           // HH:MM
  end_time    String
  room        String?
  status      String   @default("scheduled")   // scheduled | held | cancelled
  created_by  String?
  created_at  DateTime @default(now())

  subject      Subject           @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  term         Term              @relation(fields: [term_id], references: [id], onDelete: Cascade)
  offering     CourseOffering?   @relation(fields: [offering_id], references: [id], onDelete: SetNull)
  invigilators ExamInvigilator[]
  candidates   ExamCandidate[]

  @@index([term_id, date])
  @@map("exam_sessions")
}

model ExamInvigilator {
  exam_id    String
  teacher_id String

  exam    ExamSession @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  teacher Teacher     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@id([exam_id, teacher_id])
  @@map("exam_invigilators")
}

model ExamCandidate {
  id                 String    @id
  exam_id            String
  student_id         String
  eligible           Boolean   @default(true)
  ineligible_reasons Json?
  attendance         String?                   // present | absent (null = not recorded yet)
  override_by        String?
  override_reason    String?
  recorded_by        String?
  recorded_at        DateTime?

  exam    ExamSession @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@index([student_id])
  @@map("exam_candidates")
}

model GradeAppeal {
  id            String    @id
  mark_id       String
  student_id    String
  reason        String
  status        String    @default("submitted")   // submitted | under_review | upheld | rejected
  reviewed_by   String?
  decision_note String?
  new_ca        Float?
  new_exam      Float?
  created_at    DateTime  @default(now())
  decided_at    DateTime?

  mark    Mark    @relation(fields: [mark_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([status])
  @@map("grade_appeals")
}

// Single row ("main"): rules the university configures instead of us hardcoding them.
model AcademicSettings {
  id                      String   @id @default("main")
  exam_min_attendance_pct Float?                       // null = attendance not required for exam eligibility
  exam_fee_rule           String   @default("none")    // none | no_overdue | min_paid_pct
  exam_min_paid_pct       Float    @default(0)
  progression             Json?                        // see utils/progression.js for the shape + defaults
  updated_by              String?
  updated_at              DateTime @default(now())

  @@map("academic_settings")
}

model ProgressionDecision {
  id               String    @id
  student_id       String
  academic_year_id String
  programme_id     String?
  level_id         String?
  outcome          String                         // promoted | repeat | carryover | probation | eligible_graduation
  metrics          Json
  status           String    @default("proposed") // proposed | approved | applied | rejected
  target_class_id  String?
  decided_by       String?
  decided_at       DateTime?
  note             String?
  created_at       DateTime  @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, academic_year_id])
  @@index([academic_year_id, status])
  @@map("progression_decisions")
}

// Where a student was, year by year. Written whenever their cohort changes; never edited.
model StudentEnrollmentHistory {
  id               String    @id
  student_id       String
  academic_year_id String?
  class_id         String?
  class_name       String?
  programme_id     String?
  programme_name   String?
  level_name       String?
  started_at       DateTime  @default(now())
  ended_at         DateTime?
  reason           String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, started_at])
  @@map("student_enrollment_history")
}

// Issued official documents (transcript, statement of results, enrolment certificate…) with a public verification code.
model OfficialDocument {
  id               String    @id
  code             String    @unique
  type             String
  student_id       String
  academic_year_id String?
  term_id          String?
  payload          Json
  status           String    @default("issued")   // issued | revoked
  issued_by        String?
  issued_by_name   String?
  issued_at        DateTime  @default(now())
  revoked_at       DateTime?
  revoked_reason   String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, type])
  @@map("official_documents")
}

// Audit trail for academic/administrative actions (registration overrides, structure changes, decisions…).
model AcademicAudit {
  id          String   @id
  actor_id    String?
  actor_name  String?
  actor_role  String?
  action      String
  target_type String
  target_id   String
  reason      String?
  before      Json?
  after       Json?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([target_type, target_id])
  @@map("academic_audit")
}
