PORT=3001
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=24h
FRONTEND_URL=https://schoool-management-system-universit.vercel.app/

# Postgres — base connection URL, no ?schema= here. Each Prisma client (platform
# singleton, per-tenant pool) appends its own schema at runtime via
# src/db/tenantSchema.js. See prisma/platform/schema.prisma and prisma/tenant/schema.prisma.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CLI-only URLs used by `prisma migrate` (each Prisma project needs a concrete
# schema= target to diff/migrate against at build time). Runtime code never reads
# these directly — it derives the same shape from DATABASE_URL. Keep both pointed
# at the same server as DATABASE_URL.
PLATFORM_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=platform
TENANT_TEMPLATE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&schema=tenant_template

# Max simultaneously-open PrismaClient instances in the tenant connection pool
# (LRU-evicted past this cap). Mirrors the old MAX_OPEN_TENANT_DBS.
MAX_OPEN_TENANT_PRISMA_CLIENTS=25

# Optional: override the auto-bootstrapped first platform owner account
# (created only if platform_admins is empty).
# PLATFORM_ADMIN_EMAIL=superadmin@platform.local
# PLATFORM_ADMIN_PASSWORD=SuperAdmin@2025

# Bird (messagebird.com) — used to WhatsApp default login credentials to a
# school's admin when the platform admin creates a new school. Leave either
# unset to skip sending (school creation still succeeds; credentials are
# only shown on-screen). BIRD_WHATSAPP_TEMPLATE_SLUG must point at an
# approved WhatsApp template in your Bird workspace — its {{1}}..{{5}}
# placeholders receive, in order: admin name, school name, login email,
# temporary password, login URL.
BIRD_API_KEY=bk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BIRD_WHATSAPP_TEMPLATE_SLUG=school_admin_credentials

# ── E-learning live classes (Jitsi Meet) ─────────────────────────────────────
# Without one of the two blocks below, teachers can schedule classes but joining
# returns "Video conferencing is not configured". Secrets stay on the server; the
# browser only gets a short-lived per-room token.
#
# Option A — self-hosted Jitsi with JWT authentication (HS256):
# JITSI_DOMAIN=meet.yourschool.edu
# JITSI_APP_ID=edutech
# JITSI_APP_SECRET=long_random_secret_matching_prosody_config
#
# Option B — 8x8 JaaS (https://jaas.8x8.vc), RS256:
# JITSI_JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
# JITSI_JAAS_KID=vpaas-magic-cookie-xxxxxxxx/abcdef
# JITSI_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── E-learning materials & reminders ─────────────────────────────────────────
# Uploaded course materials are stored IN THE DATABASE (not on disk), so they survive redeploys on
# hosts with an ephemeral filesystem such as Render's free plan. Keep the limit modest: they count
# against your database quota (Neon free = 0.5 GB).
# ELEARNING_MAX_UPLOAD_MB=10
# In-app "class starts in 15 min" reminders run inside the API process; set to off to disable.
# ELEARNING_REMINDERS=on
